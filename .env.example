# Copy to .env for local dev, or set these as Railway service variables.
DATABASE_URL=postgres://localhost/fitcheck   # Railway: provided by the Postgres plugin
SESSION_SECRET=change-me                      # generate: openssl rand -hex 32
APP_PASSWORD=change-me                         # the single password to log in
UPLOAD_DIR=./uploads                           # Railway: mount a volume here (e.g. /data/uploads)
NODE_ENV=development

# Optional AI features
REPLICATE_API_KEY=                             # background removal (replicate.com)
OPENAI_API_KEY=                                # clothing detection (platform.openai.com)
APP_BASE_URL=                                  # Railway public URL, only needed for clothing detection
